# Copy to apps/api/.env and adjust. Never commit the real .env.

# PostgreSQL connection used by the API and `prisma migrate dev`.
# Docker Compose (docker-compose.yml): postgresql://routepulse:routepulse@localhost:5432/routepulse_dev
# Local install (e.g. Homebrew, peer auth): postgresql://localhost:5432/routepulse_dev
DATABASE_URL="postgresql://routepulse:routepulse@localhost:5432/routepulse_dev"

# Separate database for integration tests (migrated automatically by the test runner).
TEST_DATABASE_URL="postgresql://routepulse:routepulse@localhost:5432/routepulse_test"

# Signs the session cookie. At least 32 characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Enables simulator, clock and reset endpoints (coordinator only) when "true".
DEMO_MODE="true"

# HTTP port for the API.
PORT="4000"

# "development" | "test" | "production"
NODE_ENV="development"

# "info" | "silent"
LOG_LEVEL="info"
